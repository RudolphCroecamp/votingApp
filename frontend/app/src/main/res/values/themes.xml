<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose owns the app's Material 3 theming (see ui/theme/Theme.kt).
      This platform theme only covers the window before Compose draws.
      AppCompat parent because MainActivity is an AppCompatActivity (needed for
      in-app language switching below Android 13).
    -->
    <style name="Theme.Frontend" parent="Theme.AppCompat.Light.NoActionBar" />

    <!--
      Cold-start theme: replaces the stock Android icon with the ballot logo, then
      hands over to Theme.Frontend once MainActivity calls installSplashScreen().
    -->
    <style name="Theme.Frontend.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Frontend</item>
    </style>
</resources>
