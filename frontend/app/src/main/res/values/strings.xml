    <!-- Privacy consent (POPIA) -->
    <string name="consent_title">Privacy and consent</string>
    <string name="consent_heading">What we collect and why</string>
    <string name="consent_description">South Africa\'s privacy law (POPIA) says we must tell you this and get your agreement before we collect anything.</string>
    <string name="consent_no_photos_yet">No photos are taken and no face is scanned until you agree below.</string>
    <string name="consent_never_sell">We never sell your information and we never share who you voted for. Your ballot is stored separately from your identity, so no one can link the two. You may withdraw your agreement or ask us to delete your data at any time in Settings, though you cannot vote without it.</string>
