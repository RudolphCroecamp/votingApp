<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup rules for Android 12+ (KAN-44). Older versions read backup_rules.xml.

    Nothing this app keeps on the device is safe to copy to the cloud or to a new
    phone: sign-in state, ID number, cellphone, address, face and ID photos, vote
    receipts and the in-progress ballot are personal information under POPIA, and a
    restored session could let someone else act as the voter. Everything is
    excluded; after a restore the voter simply signs in again with a face scan.

    If a harmless preference ever needs to survive a restore, add an <include>
    for that one file and keep everything else excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
